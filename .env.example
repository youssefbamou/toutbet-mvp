# Copier en .env (non versionné) et remplacer les valeurs.
# Générer un secret : python -c "import secrets; print(secrets.token_hex(32))"
TOUTBET_ENV=development
TOUTBET_SECRET_KEY=remplacer-par-un-secret-aleatoire
TOUTBET_PAYMENT_WEBHOOK_SECRET=remplacer-par-le-secret-du-prestataire
TOUTBET_DATABASE=toutbet.sqlite3
TOUTBET_RATE_LIMIT_PER_MINUTE=120
TOUTBET_DISPUTE_WINDOW_SECONDS=3600
